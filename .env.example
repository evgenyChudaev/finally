# FinAlly environment configuration.
# Copy this file to .env and fill in the values you need. The .env file
# is git-ignored; the .env.example file is committed as documentation.

# --- Required ---------------------------------------------------------

# OpenRouter API key for the AI chat assistant. Get one at
# https://openrouter.ai/. Required unless LLM_MOCK=true.
OPENROUTER_API_KEY=

# --- Optional ---------------------------------------------------------

# Massive (Polygon.io) API key for real market data. If unset or empty,
# the built-in GBM simulator is used (recommended for most users).
MASSIVE_API_KEY=

# Set to "true" to bypass OpenRouter and return deterministic mock LLM
# responses. Used by E2E tests; useful for local dev without a key.
LLM_MOCK=false

# Comma-separated list of tickers used to seed an empty database.
# Leave blank to use the built-in default:
#   AAPL,GOOGL,MSFT,AMZN,TSLA,NVDA,META,JPM,V,NFLX
DEFAULT_WATCHLIST=

# Log verbosity. One of: debug, info, warning, error. Defaults to info.
LOG_LEVEL=info
